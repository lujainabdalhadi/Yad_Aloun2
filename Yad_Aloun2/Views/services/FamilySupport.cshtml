    <!-- ملفات الجافاسكربت اللازمة لبوتستراب والتفاعل الديناميكي للمنصة -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <script>
        // تعريف متغيرات المودالات للتحكم البرمجي بـ Bootstrap
        let bookingFormModal, ticketModal, myBookingsModal, confirmCancelModal;

        // مصفوفة الحجوزات مع قراءتها وتخزينها محلياً
        let myBookings = JSON.parse(localStorage.getItem('user_bookings')) || [];

        // متغيرات الحجز المؤقتة لعمليات الإلغاء والتأكيد
        let selectedActivity = null;
        let pendingCancelId = null;

        document.addEventListener("DOMContentLoaded", () => {
            // تفعيل الأيقونات التفاعلية
            lucide.createIcons();
            updateBookingsBadge();

            // ربط مودالات بوتستراب بأكواد الجافاسكربت
            bookingFormModal = new bootstrap.Modal(document.getElementById('bookingFormModal'));
            ticketModal = new bootstrap.Modal(document.getElementById('ticketModal'));
            myBookingsModal = new bootstrap.Modal(document.getElementById('myBookingsModal'));
            confirmCancelModal = new bootstrap.Modal(document.getElementById('confirmCancelModal'));

            // إسناد منطق الإلغاء لزر الحذف في مودال التأكيد المخصص
            document.getElementById('btnConfirmDelete').addEventListener('click', executeCancelBooking);
        });

        // تصفية الفعاليات بناءً على الفلاتر المحددة ومربع البحث
        function applyFilters() {
            const govVal = document.getElementById('govFilter').value;
            const typeVal = document.getElementById('typeFilter').value;
            const searchVal = document.getElementById('searchKeyword').value.toLowerCase();

            const cards = document.querySelectorAll('.activity-card-wrapper');
            const noResults = document.getElementById('noResultsMessage');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardInner = card.querySelector('.card');
                const cardGov = card.getAttribute('data-gov');
                const cardType = card.getAttribute('data-type');
                const cardTitle = cardInner.querySelector('.activity-title').innerText.toLowerCase();
                const cardDesc = cardInner.querySelector('.activity-desc').innerText.toLowerCase();

                const matchesGov = (govVal === 'all' || cardGov === govVal);
                const matchesType = (typeVal === 'all' || cardType === typeVal);
                const matchesSearch = (cardTitle.includes(searchVal) || cardDesc.includes(searchVal));

                if (matchesGov && matchesType && matchesSearch) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // إظهار رسالة عدم العثور على نتائج إذا كانت النتيجة صفراً
            noResults.style.display = (visibleCount === 0) ? 'block' : 'none';
        }

        // تفريغ الفلاتر وتعيين الحالة الافتراضية
        function resetAllFilters() {
            document.getElementById('govFilter').value = 'all';
            document.getElementById('typeFilter').value = 'all';
            document.getElementById('searchKeyword').value = '';
            applyFilters();
        }

        // إطلاق نافذة الحجز المباشر بالبيانات المستهدفة
        function openBookingForm(name, organizer, location, time) {
            selectedActivity = { name, organizer, location, time };
            document.getElementById('userName').value = '';
            document.getElementById('userPhone').value = '';
            bookingFormModal.show();
        }

        // تأكيد وتوليد تذكرة الحجز بشكل تلقائي فوري
        function handleBookingSubmit(event) {
            event.preventDefault();

            const name = document.getElementById('userName').value;
            const phone = document.getElementById('userPhone').value;

            if(!name || !phone) return;

            // كشف تكرار التسجيل لنفس المستفيد لمنع حجز مقاعد زائدة
            const alreadyBooked = myBookings.some(booking => booking.activityName === selectedActivity.name && booking.phone === phone);
            if(alreadyBooked) {
                bookingFormModal.hide();
                showBookingWarning();
                return;
            }

            // توليد رقم تسلسلي عشوائي ومحكم للتذكرة الرقمية
            const serialNum = 'YD-' + Math.floor(100000 + Math.random() * 900000);

            // إنشاء بنية بيانات الحجز
            const newBooking = {
                id: serialNum,
                activityName: selectedActivity.name,
                organizer: selectedActivity.organizer,
                location: selectedActivity.location,
                time: selectedActivity.time,
                attendee: name,
                phone: phone
            };

            myBookings.push(newBooking);
            localStorage.setItem('user_bookings', JSON.stringify(myBookings));

            // تحديث مؤشرات الحجوزات النشطة
            updateBookingsBadge();

            // تحويل الزائر من التسجيل إلى التذكرة مباشرة
            bookingFormModal.hide();
            showTicket(newBooking);
        }

        // إظهار تنبيه تكرار التسجيل المنبثق
        function showBookingWarning() {
            const warningAlert = document.getElementById('bookingWarningAlert');
            warningAlert.classList.remove('d-none');
            window.scrollTo({ top: warningAlert.offsetTop - 100, behavior: 'smooth' });
        }

        function hideBookingWarning() {
            document.getElementById('bookingWarningAlert').classList.add('d-none');
        }

        // ملء بيانات التذكرة الإلكترونية وعرضها للطباعة
        function showTicket(booking) {
            document.getElementById('ticketSerial').innerText = booking.id;
            document.getElementById('ticketActivityName').innerText = booking.activityName;
            document.getElementById('ticketAttendee').innerText = booking.attendee;
            document.getElementById('ticketPhone').innerText = booking.phone;
            document.getElementById('ticketLocation').innerText = booking.location;
            document.getElementById('ticketTime').innerText = booking.time;

            ticketModal.show();
            lucide.createIcons();
        }

        // تعبئة لوحة "حجوزاتي" بأحدث تذاكر مسجلة ومحفوظة
        function openMyBookingsModal() {
            const container = document.getElementById('myBookingsContainer');
            container.innerHTML = '';

            if (myBookings.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-5 text-muted">
                        <i data-lucide="ticket-x" class="text-secondary mb-3" style="width: 48px; height: 48px;"></i>
                        <p class="fw-bold text-dark mb-1">لا توجد لديك حجوزات نشطة حالياً</p>
                        <p class="small">تصفح قائمة الأنشطة الترفيهية واحجز مقعدك المجاني بلمسة زر واحدة!</p>
                    </div>
                `;
            } else {
                myBookings.forEach(booking => {
                    const card = document.createElement('div');
                    card.className = 'p-3 border rounded-3 bg-light d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3';
                    card.innerHTML = `
                        <div class="text-start">
                            <h4 class="h6 fw-bold mb-2" style="color: #064e3b;">${booking.activityName}</h4>
                            <div class="d-flex flex-wrap gap-3 text-muted small">
                                <span class="d-flex align-items-center gap-1">
                                    <i data-lucide="calendar" style="width: 14px;"></i>
                                    <span>${booking.time}</span>
                                </span>
                                <span class="d-flex align-items-center gap-1">
                                    <i data-lucide="ticket" style="width: 14px;"></i>
                                    <span>تذكرة رقم: ${booking.id}</span>
                                </span>
                            </div>
                        </div>
                        <div class="d-flex gap-2 justify-content-end">
                            <button class="btn btn-sm btn-light border px-3 py-1.5 fw-bold rounded-2 d-flex align-items-center gap-1" style="color: #064e3b;" onclick="viewSingleSavedTicket('${booking.id}')">
                                <i data-lucide="eye" style="width: 14px;"></i>
                                <span>عرض</span>
                            </button>
                            <button class="btn btn-sm btn-danger px-3 py-1.5 fw-bold rounded-2 d-flex align-items-center gap-1" style="background-color: #fee2e2; color: #ef4444; border: none;" onclick="confirmCancelBooking('${booking.id}')">
                                <i data-lucide="trash-2" style="width: 14px;"></i>
                                <span>إلغاء الحجز</span>
                            </button>
                        </div>
                    `;
                    container.appendChild(card);
                });
            }

            myBookingsModal.show();
            lucide.createIcons();
        }

        // عرض تفاصيل تذكرة مفردة من لوحة حجوزاتي
        function viewSingleSavedTicket(ticketId) {
            const booking = myBookings.find(b => b.id === ticketId);
            if(booking) {
                myBookingsModal.hide();
                setTimeout(() => showTicket(booking), 300);
            }
        }

        // فتح مودال التأكيد المخصص قبل المباشرة بإلغاء الحجز
        function confirmCancelBooking(ticketId) {
            const booking = myBookings.find(b => b.id === ticketId);
            if (!booking) return;

            pendingCancelId = ticketId;
            document.getElementById('cancelConfirmationText').innerText = `هل أنت متأكد من رغبتك في إلغاء حجزك لفعالية "${booking.activityName}"؟ سيتم توفير هذا المقعد لمستفيدين آخرين فوراً.`;

            myBookingsModal.hide();
            setTimeout(() => confirmCancelModal.show(), 300);
        }

        // إلغاء المقعد ومسحه من قاعدة البيانات المحلية وإتاحة الفرصة للآخرين
        function executeCancelBooking() {
            if (!pendingCancelId) return;

            myBookings = myBookings.filter(b => b.id !== pendingCancelId);
            localStorage.setItem('user_bookings', JSON.stringify(myBookings));

            updateBookingsBadge();
            confirmCancelModal.hide();

            setTimeout(() => openMyBookingsModal(), 300);
            pendingCancelId = null;
        }

        // تحديث مؤشرات التذاكر النشطة على الأزرار والشارات
        function updateBookingsBadge() {
            const btnBadge = document.getElementById('btnBadge');
            const count = myBookings.length;

            if (count > 0) {
                btnBadge.style.display = 'inline-block';
                btnBadge.innerText = count;
            } else {
                btnBadge.style.display = 'none';
            }
        }

        // طباعة التذكرة الرقمية الفردية أو استخراجها كملف PDF
        function printTicket() {
            window.print();
        }
    </script>
</body>
</html>