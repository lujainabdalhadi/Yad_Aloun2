</head>
<body class="bg-light text-dark" style="font-family: 'Cairo', sans-serif;">

    <!-- شريط التنقل العلوي المتجاوب (Navbar) المعتمد كلياً على فئات Bootstrap ولون مخصص -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm py-2 sticky-top" style="background-color: #064e3b;">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-3" href="#">
                <div class="bg-white d-flex align-items-center justify-content-center rounded-3" style="width: 42px; height: 42px; color: #064e3b;">
                    <i class="fa-solid fa-hand-holding-heart text-white" style="font-size:40px;"></i>
                </div>
                <div>
                    <h1 class="h5 m-0 fw-bold text-white">يد العون</h1>
                    <p class="m-0 text-white-50" style="font-size: 0.72rem;">مبادرات ترفيهية ونفسية ملهمة</p>
                </div>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-2">
                    <li class="nav-item">
                        <a class="nav-link text-white fw-bold active" aria-current="page" href="/Home/Index"></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white-50" href="#activitiesSection"></a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2 ms-lg-3 mt-3 mt-lg-0">
                    <button class="btn btn-outline-light rounded-pill px-4 fw-bold d-flex align-items-center gap-2" onclick="openMyBookingsModal()">
                        <i data-lucide="ticket" style="width: 18px; height: 18px;"></i>
                        <span>تذاكري</span>
                        <span class="badge bg-danger rounded-pill" id="btnBadge" style="display: none;">0</span>
                    </button>
                    <!--button class="btn btn-light rounded-pill px-4 fw-bold" style="color: #064e3b;">بوابة المستفيد</!--button-->
                </div>
            </div>
        </div>
    </nav>

    <!-- المحتوى الرئيسي للمنصة -->
    <main class="container py-5">

        <!-- مقدمة الصفحة والترحيب بالزوار -->
        <div class="text-center mb-5">
            <h2 class="display-6 fw-bold mb-3" style="color: #064e3b;">الأنشطة الترفيهية وبرامج الدعم النفسي</h2>
            <p class="text-muted mx-auto" style="max-width: 700px; font-size: 1.1rem;">
                مجتمع ترفيهي ونفسي آمن ومخصص بالكامل للأشخاص ذوي الإعاقة وعائلاتهم في الأردن. نهدف لدمج المجتمع بالحب والمرح عبر تذاكر رقمية فورية ومجانية.
            </p>
            <div class="mx-auto rounded-pill" style="width: 100px; height: 4px; background-color: #064e3b;"></div>
        </div>

        <!-- فلاتر تصفية الفعاليات المعتمدة على تصميم مكونات بوتستراب والبطاقات -->
        <div class="card border-0 rounded-4 shadow-sm mb-5 p-4 bg-white">
            <div class="row g-3">

                <!-- فلتر تحديد المحافظات الأردنية -->
                <div class="col-md-3">
                    <label class="form-label fw-bold small mb-2" style="color: #064e3b;">المحافظة الأردنية</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0" style="color: #064e3b;"><i data-lucide="map-pin" style="width: 18px;"></i></span>
                        <select id="govFilter" class="form-select bg-light border-0 py-2" onchange="applyFilters()">
                            <option value="all">كل المحافظات والأماكن</option>
                            <option value="عمان">عمان</option>
                            <option value="إربد">إربد</option>
                            <option value="الزرقاء">الزرقاء</option>
                            <option value="السلط">السلط (البلقاء)</option>
                            <option value="العقبة">العقبة</option>
                        </select>
                    </div>
                </div>

                <!-- فلتر نوع المبادرة والنشاط -->
                <div class="col-md-3">
                    <label class="form-label fw-bold small mb-2" style="color: #064e3b;">نوع النشاط والبرنامج</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0" style="color: #064e3b;"><i data-lucide="sparkles" style="width: 18px;"></i></span>
                        <select id="typeFilter" class="form-select bg-light border-0 py-2" onchange="applyFilters()">
                            <option value="all">كل أنواع البرامج</option>
                            <option value="دعم نفسي">برامج إرشاد ودعم نفسي</option>
                            <option value="ترفيهي ورياضي">أنشطة ترفيهية ورياضية</option>
                            <option value="علاج بالفن">علاج بالموسيقى والفن</option>
                            <option value="لقاء اجتماعي">لقاءات تواصل اجتماعي</option>
                        </select>
                    </div>
                </div>

                <!-- فلتر البحث بالنص الحر والكلمة المفتاحية -->
                <div class="col-md-3">
                    <label class="form-label fw-bold small mb-2" style="color: #064e3b;">البحث بكلمة مفتاحية</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0" style="color: #064e3b;"><i data-lucide="search" style="width: 18px;"></i></span>
                        <input type="text" id="searchKeyword" class="form-control bg-light border-0 py-2" placeholder="رسم، يوغا، رياضة..." onkeyup="applyFilters()">
                    </div>
                </div>

                <!-- زر إعادة تصفير الفلاتر -->
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn w-100 py-2 fw-bold rounded-3" style="background-color: rgba(6, 78, 59, 0.1); color: #064e3b; border: none;" onclick="resetAllFilters()">
                        <i data-lucide="rotate-ccw" class="me-1" style="width: 16px; vertical-align: middle;"></i>
                        <span>إعادة تعيين</span>
                    </button>
                </div>

            </div>
        </div>

        <!-- تنبيه الخطأ والتحذير المخصص من بوتستراب لتجنب تكرار الحجوزات -->
        <div id="bookingWarningAlert" class="alert alert-danger alert-dismissible fade show d-none mb-4 rounded-4 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i data-lucide="alert-triangle" class="text-danger" style="width: 24px; height: 24px;"></i>
                <div>
                    <strong>عذراً!</strong> رقم الهاتف هذا مسجل بالفعل في هذه الفعالية سابقاً.
                </div>
            </div>
            <button type="button" class="btn-close" onclick="hideBookingWarning()"></button>
        </div>

        <!-- شبكة عرض المبادرات التفاعلية -->
        <div id="activitiesSection" class="row g-4">

            <!-- فعالية 1 -->
            <div class="col-md-6 col-lg-4 activity-card-wrapper" data-gov="عمان" data-type="دعم نفسي">
                <div class="card h-100 border-0 rounded-4 shadow-sm d-flex flex-column">
                    <div class="p-4 pb-1 d-flex justify-content-between align-items-center">
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1.5 fw-bold" style="font-size: 0.75rem;">دعم نفسي</span>
                        <span class="badge bg-light text-secondary rounded-3 px-3 py-1.5 fw-bold" style="font-size: 0.75rem;">عمان</span>
                    </div>
                    <div class="p-4 pt-2 flex-grow-1">
                        <h3 class="activity-title h5 fw-bold mb-3" style="color: #064e3b;">جلسة دعم نفسي وتفريغ وجداني</h3>
                        <p class="activity-desc text-muted mb-4 small" style="line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; height: 4.8em;">جلسة حوارية تفاعلية دافئة تتيح للأشخاص ذوي الإعاقة التعبير عن مشاعرهم وتطوير المرونة النفسية بإشراف نخبة من الأخصائيين النفسيين المعتمدين.</p>

                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 mb-2 border">
                            <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; flex-shrink: 0; background-color: rgba(6, 78, 59, 0.1); color: #064e3b;">
                                <i data-lucide="building" style="width: 16px;"></i>
                            </div>
                            <div>
                                <span class="text-muted d-block" style="font-size: 0.75rem;">الجهة المنظمة للمبادرة</span>
                                <span class="fw-bold d-block text-dark small">جمعية الياسمين الخيرية</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 mb-2 border">
                            <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; flex-shrink: 0; background-color: rgba(6, 78, 59, 0.1); color: #064e3b;">
                                <i data-lucide="map" style="width: 16px;"></i>
                            </div>
                            <div>
                                <span class="text-muted d-block" style="font-size: 0.75rem;">المكان التفصيلي</span>
                                <span class="fw-bold d-block text-dark small">جبل عمان - مركز الدعم الاجتماعي</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 mb-2 border">
                            <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; flex-shrink: 0; background-color: rgba(6, 78, 59, 0.1); color: #064e3b;">
                                <i data-lucide="calendar" style="width: 16px;"></i>
                            </div>
                            <div>
                                <span class="text-muted d-block" style="font-size: 0.75rem;">الزمان والتوقيت</span>
                                <span class="fw-bold d-block text-dark small">كل سبت | 10:00 صباحاً - 12:00 ظهراً</span>
                            </div>
                        </div>
                    </div>
                    <div class="p-4 bg-light border-top">
                        <button class="btn w-100 py-2.5 fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2 text-white" style="background-color: #064e3b; border: none;" onclick="openBookingForm('جلسة دعم نفسي وتفريغ وجداني', 'جمعية الياسمين الخيرية', 'جبل عمان - مركز الدعم الاجتماعي', 'كل سبت | 10:00 صباحاً - 12:00 ظهراً')">
                            <i data-lucide="check-circle" style="width: 18px;"></i>
                            <span>حجز مقعد مجاني</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- فعالية 2 -->
            <div class="col-md-6 col-lg-4 activity-card-wrapper" data-gov="إربد" data-type="علاج بالفن">
                <div class="card h-100 border-0 rounded-4 shadow-sm d-flex flex-column">
                    <div class="p-4 pb-1 d-flex justify-content-between align-items-center">
                        <span class="badge bg-purple-subtle text-purple rounded-pill px-3 py-1.5 fw-bold" style="background-color: #f3e8ff; color: #6b21a8; font-size: 0.75rem;">علاج بالفن</span>
                        <span class="badge bg-light text-secondary rounded-3 px-3 py-1.5 fw-bold" style="font-size: 0.75rem;">إربد</span>
                    </div>
                    <div class="p-4 pt-2 flex-grow-1">
                        <h3 class="activity-title h5 fw-bold mb-3" style="color: #064e3b;">ورشة ألوان وأصوات للتفريغ التعبيري</h3>
                        <p class="activity-desc text-muted mb-4 small" style="line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; height: 4.8em;">استكشاف الإمكانات الإبداعية الكامنة من خلال الرسم الحر والموسيقى التعبيرية الهادئة لتعزيز الثقة بالنفس وتطوير المهارات الحركية الدقيقة بصحبة فنانين داعمين.</p>

                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 mb-2 border">
                            <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; flex-shrink: 0; background-color: rgba(6, 78, 59, 0.1); color: #064e3b;">
                                <i data-lucide="building" style="width: 16px;"></i>
                            </div>
                            <div>
                                <span class="text-muted d-block" style="font-size: 0.75rem;">الجهة المنظمة للمبادرة</span>
                                <span class="fw-bold d-block text-dark small">مؤسسة جود للتنمية الإبداعية</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 mb-2 border">
                            <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; flex-shrink: 0; background-color: rgba(6, 78, 59, 0.1); color: #064e3b;">
                                <i data-lucide="map" style="width: 16px;"></i>
                            </div>
                            <div>
                                <span class="text-muted d-block" style="font-size: 0.75rem;">المكان التفصيلي</span>
                                <span class="fw-bold d-block text-dark small">إربد - بيت السرايا القديم</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 mb-2 border">
                            <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; flex-shrink: 0; background-color: rgba(6, 78, 59, 0.1); color: #064e3b;">
                                <i data-lucide="calendar" style="width: 16px;"></i>
                            </div>
                            <div>
                                <span class="text-muted d-block" style="font-size: 0.75rem;">الزمان والتوقيت</span>
                                <span class="fw-bold d-block text-dark small">الأربعاء، 17 يونيو | 4:30 عصراً</span>
                            </div>
                        </div>
                    </div>
                    <div class="p-4 bg-light border-top">
                        <button class="btn w-100 py-2.5 fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2 text-white" style="background-color: #064e3b; border: none;" onclick="openBookingForm('ورشة ألوان وأصوات للتفريغ التعبيري', 'مؤسسة جود للتنمية الإبداعية', 'إربد - بيت السرايا القديم', 'الأربعاء، 17 يونيو | 4:30 عصراً')">
                            <i data-lucide="check-circle" style="width: 18px;"></i>
                            <span>حجز مقعد مجاني</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- فعالية 3 -->
            <div class="col-md-6 col-lg-4 activity-card-wrapper" data-gov="الزرقاء" data-type="ترفيهي ورياضي">
                <div class="card h-100 border-0 rounded-4 shadow-sm d-flex flex-column">
                    <div class="p-4 pb-1 d-flex justify-content-between align-items-center">
                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-1.5 fw-bold" style="background-color: #fef3c7; color: #92400e; font-size: 0.75rem;">ترفيهي ورياضي</span>
                        <span class="badge bg-light text-secondary rounded-3 px-3 py-1.5 fw-bold" style="font-size: 0.75rem;">الزرقاء</span>
                    </div>
                    <div class="p-4 pt-2 flex-grow-1">
                        <h3 class="activity-title h5 fw-bold mb-3" style="color: #064e3b;">يوم الألعاب المائية والحركية الدامجة</h3>
                        <p class="activity-desc text-muted mb-4 small" style="line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; height: 4.8em;">مجموعة من الألعاب الرياضية والأنشطة الترفيهية المجهزة والآمنة التي تهدف لتنشيط المهارات الجسدية وبث روح المرح والبهجة في قلوب أبطالنا الرائعين.</p>

                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 mb-2 border">
                            <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; flex-shrink: 0; background-color: rgba(6, 78, 59, 0.1); color: #064e3b;">
                                <i data-lucide="building" style="width: 16px;"></i>
                            </div>
                            <div>
                                <span class="text-muted d-block" style="font-size: 0.75rem;">الجهة المنظمة للمبادرة</span>
                                <span class="fw-bold d-block text-dark small">نادي الأمل والوفاء لذوي الإعاقة</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 mb-2 border">
                            <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; flex-shrink: 0; background-color: rgba(6, 78, 59, 0.1); color: #064e3b;">
                                <i data-lucide="map" style="width: 16px;"></i>
                            </div>
                            <div>
                                <span class="text-muted d-block" style="font-size: 0.75rem;">المكان التفصيلي</span>
                                <span class="fw-bold d-block text-dark small">الزرقاء - صالة مدينة الأمير محمد الرياضية</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 mb-2 border">
                            <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; flex-shrink: 0; background-color: rgba(6, 78, 59, 0.1); color: #064e3b;">
                                <i data-lucide="calendar" style="width: 16px;"></i>
                            </div>
                            <div>
                                <span class="text-muted d-block" style="font-size: 0.75rem;">الزمان والتوقيت</span>
                                <span class="fw-bold d-block text-dark small">الجمعة، 19 يونيو | 9:30 صباحاً</span>
                            </div>
                        </div>
                    </div>
                    <div class="p-4 bg-light border-top">
                        <button class="btn w-100 py-2.5 fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2 text-white" style="background-color: #064e3b; border: none;" onclick="openBookingForm('يوم الألعاب المائية والحركية الدامجة', 'نادي الأمل والوفاء لذوي الإعاقة', 'الزرقاء - صالة مدينة الأمير محمد الرياضية', 'الجمعة، 19 يونيو | 9:30 صباحاً')">
                            <i data-lucide="check-circle" style="width: 18px;"></i>
                            <span>حجز مقعد مجاني</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- فعاليات إضافية متجاوبة بالكامل -->
            <div class="col-md-6 col-lg-4 activity-card-wrapper" data-gov="العقبة" data-type="ترفيهي ورياضي">
                <div class="card h-100 border-0 rounded-4 shadow-sm d-flex flex-column">
                    <div class="p-4 pb-1 d-flex justify-content-between align-items-center">
                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-1.5 fw-bold" style="background-color: #fef3c7; color: #92400e; font-size: 0.75rem;">ترفيهي ورياضي</span>
                        <span class="badge bg-light text-secondary rounded-3 px-3 py-1.5 fw-bold" style="font-size: 0.75rem;">العقبة</span>
                    </div>
                    <div class="p-4 pt-2 flex-grow-1">
                        <h3 class="activity-title h5 fw-bold mb-3" style="color: #064e3b;">رحلة بحرية ترفيهية ويوجا الشاطئ</h3>
                        <p class="activity-desc text-muted mb-4 small" style="line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; height: 4.8em;">مغامرة بحرية لطيفة في خليج العقبة على قارب مهيأ، تتخللها تمارين يوجا ميسرة على الشاطئ لتنشيط الحواس والتأمل النفسي في بيئة طبيعية نقية.</p>

                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 mb-2 border">
                            <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; flex-shrink: 0; background-color: rgba(6, 78, 59, 0.1); color: #064e3b;">
                                <i data-lucide="building" style="width: 16px;"></i>
                            </div>
                            <div>
                                <span class="text-muted d-block" style="font-size: 0.75rem;">الجهة المنظمة للمبادرة</span>
                                <span class="fw-bold d-block text-dark small">ملتقى ثغر الأردن للتأهيل</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-3 mb-2 border">
                            <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; flex-shrink: 0; background-color: rgba(6, 78, 59, 0.1); color: #064e3b;">
