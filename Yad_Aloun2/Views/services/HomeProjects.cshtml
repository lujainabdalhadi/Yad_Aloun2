@model IEnumerable<Yad_Aloun2.Models.HomeProject>

@{
    ViewData["Title"] = "يد العون - سوق المشاريع";
    Layout = "_Layout";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

<style>

    /* تأثيرات مخصصة لجعل الفلاتر فائقة الجمال والاستجابة */
    .filter-badge {
        border: 1.5px solid #e0e7ff;
        background-color: #f8fafc;
        color: #475569;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }

        .filter-badge:hover {
            background-color: #f0fdf4;
            border-color: #86efac;
            color: #166534;
            transform: translateY(-2px);
        }

        .filter-badge.active-filter {
            background-color: #064e3b !important;
            border-color: #064e3b !important;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(6, 78, 59, 0.25);
        }
</style>

<div class="container-fluid p-0" dir="rtl">

    <nav class="navbar navbar-dark px-4 py-3 shadow-sm" style="background-color: #064e3b !important;">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-hand-holding-heart text-white" style="font-size:42px;"></i>
                    <span class="h3 fw-bold text-white mb-0">يد العون</span>
                </div>
                <div class="vr text-white opacity-50" style="height: 24px;"></div>
                <div class="text-white fw-bold fs-5">بوابة سوق المشاريع</div>
            </div>

            <input id="searchBox" class="form-control w-25 rounded-pill text-end" placeholder="ابحث عن مشروع..." />

            <button class="btn btn-outline-light rounded-pill px-4" onclick="location.href='@Url.Action("Support", "services")'">
                <i class="fas fa-headset me-2"></i> الدعم الفني
            </button>
        </div>
    </nav>

    <div id="hero" class="mx-4 my-4 rounded-5 overflow-hidden shadow-lg border border-4 text-white" style="background-color: #064e3b; border-color: #064e3b !important;">
        <div class="row g-0">
            <div class="col-md-6 p-5 d-flex flex-column justify-content-center text-end">
                <h1 class="display-4 fw-bold mb-3">سوق المشاريع المنزلية</h1>
                <p class="lead opacity-75 mb-4 fw-medium">إبداعات بأيدٍ مبدعة تتحدى الصعاب. اكتشف منتجات فريدة مصنوعة بكل حب.</p>
                <div>
                    @if (ViewBag.IsLoggedIn == true)
                    {
                        <button onclick="openModal()" class="btn bg-white px-5 py-3 rounded-4 fw-bold shadow-lg d-inline-flex align-items-center gap-2 fs-5" style="color: #064e3b !important; border: none;">
                            🚀 ابدأ بإضافة مشروعك الآن
                        </button>
                    }
                    else
                    {
                        <a href="/User/Login" class="btn bg-white px-5 py-3 rounded-4 fw-bold shadow-lg d-inline-flex align-items-center gap-2 fs-5" style="color: #064e3b !important; border: none; text-decoration: none;">
                            🚀 سجّل دخولك لإضافة مشروع
                        </a>
                    }
                </div>
            </div>
            <div class="col-md-6 position-relative" style="min-height: 350px;">
                <img src=https://images.unsplash.com/photo-1513151233558-d860c5398176?w =800%22 alt="سوق المشاريع المنزلية" class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover;">
            </div>
        </div>
    </div>

    @if (TempData["LoginRequired"] != null)
    {
        <div class="alert alert-warning text-end fw-bold mx-4 mt-3">
            ⚠️ @TempData["LoginRequired"]
        </div>
    }

    <div class="container py-4">

        <div class="d-flex align-items-center gap-2 mb-3">
            <i data-lucide="tag" class="text-success"></i>
            <h2 class="fs-4 fw-bolder text-dark m-0">اكتشف حسب التصنيف</h2>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-5 justify-content-start border-bottom pb-4">
            <button class="btn filter-badge active-filter px-4 py-2 fw-bold rounded-pill fs-5" onclick="filterCategory('الكل', this)">
                📌 الكل
            </button>
            <button class="btn filter-badge px-4 py-2 fw-bold rounded-pill fs-5" onclick="filterCategory('يدوي', this)">
                🎨 يدوي
            </button>
            <button class="btn filter-badge px-4 py-2 fw-bold rounded-pill fs-5" onclick="filterCategory('أطعمة', this)">
                🍲 أطعمة
            </button>
            <button class="btn filter-badge px-4 py-2 fw-bold rounded-pill fs-5" onclick="filterCategory('ملابس', this)">
                👗 ملابس
            </button>
        </div>

        <div class="row g-4" id="productsContainer">
            @foreach (var item in Model)
            {
                <div class="col-md-4 col-lg-3 product-card" data-category="@item.Category" data-name="@item.ProjectName">
                    <div class="card h-100 shadow-sm rounded-4 border border-2 text-end overflow-hidden" style="border-color: #e0e0e0 !important;">
                        <img src="@item.ImagePath" class="card-img-top border-bottom" style="height:240px; object-fit:cover;" />
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <h4 class="fw-bold text-dark mb-2">@item.ProjectName</h4>
                                <p class="text-muted fs-6 mb-3">
                                    <i class="fas fa-user-circle text-secondary me-1"></i> <strong>صاحب المشروع:</strong> @item.OwnerName
                                </p>
                                <p class="card-text text-secondary fs-5 mb-4" style="line-height: 1.6;">
                                    @item.Description
                                </p>
                            </div>
                            <div>
                                <hr class="text-muted opacity-25 my-3">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fs-4 fw-bold" style="color: #064e3b !important;">
                                        <i class="fas fa-tags me-1" style="font-size: 18px;"></i> @item.Price د.أ
                                    </span>
                                    <span class="text-dark fw-medium fs-5">
                                        <i class="fas fa-phone-alt text-success me-1" style="font-size: 16px;"></i> @item.ContactNumber
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <span class="badge px-3 py-2 fs-6 text-white" style="background-color: #064e3b !important; border-radius: 8px;">
                                        <i class="fas fa-layer-group me-1" style="font-size: 12px;"></i> @item.Category
                                    </span>

                                    @if (ViewBag.IsLoggedIn == true && ViewBag.CurrentUserId == item.UserId)
                                    {
                                        <div class="btn-group gap-2">
                                            <a href="/services/EditProject?id=@item.Id" class="btn btn-sm btn-outline-primary rounded-2 px-3 fw-bold fs-6">تعديل</a>
                                            <a href="/services/DeleteProject?id=@item.Id" class="btn btn-sm btn-outline-danger rounded-2 px-3 fw-bold fs-6" onclick="return confirm('هل تريد حذف المشروع؟')">حذف</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<div id="addModal" class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-none" style="z-index: 1050;">
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="bg-white p-4 rounded-4 shadow w-50">
            <h4 class="fw-bold mb-3" style="color: #064e3b !important;">إضافة مشروع جديد</h4>
            <form asp-action="CreateProject" method="post" enctype="multipart/form-data">
                <input name="ProjectName" class="form-control mb-2 text-end" placeholder="اسم المشروع" />
                <input name="OwnerName" class="form-control mb-2 text-end" placeholder="المالك" />
                <input name="ContactNumber" class="form-control mb-2 text-end" placeholder="رقم الهاتف" />
                <input name="Price" type="number" class="form-control mb-2 text-end" placeholder="السعر" />
                <input name="Category" class="form-control mb-2 text-end" placeholder="التصنيف" />
                <textarea name="Description" class="form-control mb-2 text-end" placeholder="الوصف"></textarea>
                <input type="file" name="imageFile" class="form-control mb-3" />

                <button class="btn text-white w-100 fw-bold" style="background-color: #064e3b !important;">حفظ المشروع</button>
                <button type="button" class="btn btn-light w-100 mt-2" onclick="closeAddModal()">إغلاق</button>
            </form>
        </div>
    </div>
</div>

<script>
    function openModal() {
        openAddModal();
    }

    function openAddModal() {
        document.getElementById("addModal").classList.remove("d-none");
    }

    function closeAddModal() {
        document.getElementById("addModal").classList.add("d-none");
    }

    /* فلترة مع نقل التثبيت النشط */
    function filterCategory(cat, element) {
        // إزالة الفلتر النشط من كافة الأزرار القديمة
        document.querySelectorAll('.filter-badge').forEach(btn => {
            btn.classList.remove('active-filter');
        });

        // تفعيل الزر المضغوط حالياً
        if(element) {
            element.classList.add('active-filter');
        }

        let cards = document.querySelectorAll(".product-card");
        cards.forEach(c => {
            let category = c.getAttribute("data-category");
            if (cat === "الكل" || category === cat) {
                c.style.display = "block";
            } else {
                c.style.display = "none";
            }
        });
    }

    /* بحث */
    document.getElementById("searchBox").addEventListener("input", function () {
        let value = this.value.toLowerCase().trim();
        document.querySelectorAll(".product-card").forEach(card => {
            let name = card.getAttribute("data-name").toLowerCase();
            card.style.display = name.includes(value) ? "block" : "none";
        });
    });
</script> 