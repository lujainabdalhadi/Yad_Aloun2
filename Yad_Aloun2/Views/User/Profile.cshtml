@model Yad_Aloun2.Models.User

@{
    ViewData["Title"] = "تعديل ملفي الشخصي";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container-fluid p-0 m-0 min-vh-100 bg-light">

    <div class="position-relative py-5 text-center text-white" style="background-color: #064e3b;">

        <div class="position-absolute top-0 end-0 m-3">
            <form asp-controller="User" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-light rounded-pill px-3 opacity-75">
                    <i class="bi bi-box-arrow-right me-1"></i> خروج
                </button>
            </form>
        </div>

        <div class="d-flex flex-column align-items-center">
            <div class="rounded-circle d-flex align-items-center justify-content-center bg-white bg-opacity-25 border border-4 border-white mb-3" style="width: 110px; height: 110px;">
                <i class="bi bi-person-fill text-white" style="font-size: 3.5rem;"></i>
            </div>
            <h2 class="fw-bold mb-1">@Model?.FullName</h2>
            <p class="mb-0 text-white-50 fs-6">إدارة وتحديث بيانات حسابك الشخصي</p>
        </div>
    </div>

    <div class="px-4 py-5 px-md-5 bg-white">
        <div class="row justify-content-center">
            <div class="col-12">

                <form asp-action="EditProfile" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                    <input type="hidden" asp-for="User_Id" />

                    <div class="mb-5">
                        <h5 class="fw-bold border-bottom pb-2 mb-4" style="color: #064e3b;">
                            <i class="bi bi-person-lines-fill me-2"></i> المعلومات الأساسية
                        </h5>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="fw-bold text-secondary mb-2 small">الاسم الكامل</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="FullName" class="form-control bg-light border-start-0 py-2.5 rounded-end-3" placeholder="أدخل اسمك الكامل" />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold text-secondary mb-2 small">البريد الإلكتروني</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control bg-light border-start-0 py-2.5 rounded-end-3 text-start" placeholder="example@domain.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-5">
                        <h5 class="fw-bold border-bottom pb-2 mb-4" style="color: #064e3b;">
                            <i class="bi bi-telephone-inbound me-2"></i> بيانات الاتصال والعنوان
                        </h5>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="fw-bold text-secondary mb-2 small">رقم الهاتف الشخصي</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-phone"></i></span>
                                    <input asp-for="Phone" class="form-control bg-light border-start-0 py-2.5 rounded-end-3 text-start" placeholder="05xxxxxxxx" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold text-secondary mb-2 small">رقم هاتف العائلة (للطوارئ)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-heart-fill text-danger small"></i></span>
                                    <input asp-for="FamilyPhoneNumber" class="form-control bg-light border-start-0 py-2.5 rounded-end-3 text-start" placeholder="05xxxxxxxx" />
                                </div>
                                <span asp-validation-for="FamilyPhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-12">
                                <label class="fw-bold text-secondary mb-2 small">الموقع السكني / العنوان</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="location" class="form-control bg-light border-start-0 py-2.5 rounded-end-3" placeholder="المدينة، الحي، الشارع" />
                                </div>
                                <span asp-validation-for="location" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-5">
                        <h5 class="fw-bold border-bottom pb-2 mb-4" style="color: #064e3b;">
                            <i class="bi bi-info-circle me-2"></i> تفاصيل إضافية
                        </h5>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="fw-bold text-secondary mb-2 small">نوع الإعاقة (إن وجد)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-activity"></i></span>
                                    <input asp-for="DisabilityType" class="form-control bg-light border-start-0 py-2.5 rounded-end-3" placeholder="حدد نوع الإعاقة أو اكتب لا يوجد" />
                                </div>
                                <span asp-validation-for="DisabilityType" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold text-secondary mb-2 small">العمر</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-calendar3"></i></span>
                                    <input asp-for="Age" type="number" class="form-control bg-light border-start-0 py-2.5 rounded-end-3" placeholder="العمر بالسنوات" />
                                </div>
                                <span asp-validation-for="Age" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-4 border-top d-flex gap-3 justify-content-center flex-wrap">
                        <button type="submit" class="btn text-white rounded-pill px-5 py-2.5 fw-bold shadow-sm" style="background-color: #064e3b;">
                            <i class="bi bi-check-circle me-1"></i> حفظ التغييرات الحالية
                        </button>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary px-4 py-2.5 rounded-pill shadow-sm">
                            <i class="bi bi-arrow-right-short me-1"></i> العودة للرئيسية
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

