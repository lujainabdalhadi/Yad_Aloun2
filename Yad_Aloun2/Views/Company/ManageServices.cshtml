@model IEnumerable<Yad_Aloun2.Models.ServiceItem>

@{
    ViewData["Title"] = "إدارة الخدمات";
    Layout = "_Layout";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold">إدارة خدماتي</h4>

        <a asp-action="CreateService"
           asp-controller="Company"
           class="btn btn-success rounded-pill px-4">
            + إضافة خدمة
        </a>
    </div>

    <!-- Card -->
    <div class="card shadow-sm rounded-4">

        <!-- Top bar -->
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
            <span class="text-muted">
                إجمالي الخدمات: @Model.Count()
            </span>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table text-center align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>اسم الخدمة</th>
                        <th>القسم</th>
                        <th>الاستخدام</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.Category</td>
                            <td>@item.Usage مرة</td>

                            <td>
                                <span class="badge rounded-pill px-3 py-2
                                            @(item.Available ? "bg-success-subtle text-success" : "bg-danger-subtle text-dark")">
                                    @(item.Available ? "متوفر" : "غير متوفر")
                                </span>
                            </td>

                            <td>
                                <a asp-action="EditService"
                                   asp-route-id="@item.Id"
                                   class="text-secondary me-2">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="DeleteService"
                                   asp-route-id="@item.Id"
                                   class="text-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>
</div>