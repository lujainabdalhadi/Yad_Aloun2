@model IEnumerable<Yad_Aloun2.Models.AssistanceRequest>

<div class="container mt-5" dir="rtl">
    <h3 class="fw-bold text-success mb-4">لوحة إدارة طلبات المساعدة</h3>

    <table class="table table-hover shadow-sm">
        <thead class="text-white" style="background:#064e3b;">
            <tr>
                <th>المستخدم</th>
                <th>التصنيف</th>
                <th>العنوان</th>
                <th>الحالة</th>
                <th>رد الشركة الحالي</th>
                <th>إجراء الرد</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.User_Id</td>
                    <td>@item.Category</td>
                    <td>@item.Title</td>
                    <td>
                        <span class="badge @(item.Status == "Pending" ? "bg-warning text-dark" : "bg-success")">
                            @item.Status
                        </span>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.AdminNotes))
                        {
                            <small class="text-info">@item.AdminNotes</small>
                        }
                        else
                        {
                            <span class="text-muted">لا يوجد رد</span>
                        }
                    </td>
                    <td>
                        <form asp-controller="Company" asp-action="ReplyRequest" method="post">
                            <input type="hidden" name="id" value="@item.Id" />
    <textarea name="notes" class="form-control mb-2">@item.AdminNotes</textarea>
                            <button type="submit" class="btn btn-success btn-sm w-100">حفظ وإرسال الرد</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>