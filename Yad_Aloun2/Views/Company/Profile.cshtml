@model Yad_Aloun2.Models.Donor_Company

@{
    ViewData["Title"] = "ملف الشركة";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
    body {
        background: #f5f7f7;
        direction: rtl;
    }

    .profile-card {
        background: white;
        border-radius: 25px;
        padding: 30px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
    }

    .company-icon {
        width: 150px;
        height: 150px;
        background: #006b52;
        border-radius: 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        font-size: 60px;
        margin: auto;
    }

    .form-control {
        background: #f7f7f7;
        border: none;
        min-height: 55px;
    }
</style>

<div class="container-fluid px-4 mt-4">

    <!-- Header -->
    <div class="row align-items-center mb-4">

        <!-- العنوان -->
        <div class="col-md-6 text-end">

            <div class="d-inline-flex align-items-center">

                <div class="bg-success-subtle rounded-3 p-3 ms-3">
                    <i class="bi bi-building text-success fs-3"></i>
                </div>

                <div>
                    <h1 class="fw-bold mb-0">ملف الشركة</h1>
                    <small class="text-muted">إدارة بيانات الشركة</small>
                </div>

            </div>

        </div>

        <!-- search -->
        <div class="col-md-6 text-start">

            <input type="text"
                   class="form-control rounded-pill"
                   style="max-width:350px;"
                   placeholder="بحث في الخدمات أو الطلبات...">

        </div>

    </div>

    <!-- Profile Card -->
    <div class="profile-card">

        <div class="row align-items-center mb-5">

            <div class="col-md-4 text-center">

                <div class="company-icon">
                    <i class="bi bi-building"></i>
                </div>

                <button class="btn btn-light rounded-circle shadow mt-3">
                    <i class="bi bi-pencil"></i>
                </button>

            </div>

            <div class="col-md-8 text-end">

                <h2 class="fw-bold">
                    @Model.CompanyName
                </h2>

                <h5 class="text-success">
                    شريك استراتيجي - خدمات طبية
                </h5>

                <div class="mt-3">

                    <span class="badge bg-success">
                        موثق
                    </span>

                    <span class="text-muted ms-3">
                        رقم السجل: 101XXXXXXX
                    </span>

                </div>

            </div>

        </div>

        <div class="row g-4">

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    موقع رئيسي
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.Company_Address"
                       readonly>

            </div>

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    نبذة الشركة
                </label>

                <textarea class="form-control" rows="4" readonly>
نحن شركة رائدة في توفير الحلول الطبية المساعدة لذوي الإعاقة.
                </textarea>

            </div>

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    رقم الهاتف
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.Phone"
                       readonly>

            </div>

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    البريد الإلكتروني
                </label>

                <input type="email"
                       class="form-control"
                       value="@Model.Email"
                       readonly>

            </div>

        </div>

        <div class="mt-5">

            <button class="btn btn-success w-100 py-3 rounded-4">
                تحديث بيانات المنشأة
            </button>

        </div>

    </div>

</div>