@model IEnumerable<Yad_Aloun2.Models.usaglog>

@{
    ViewData["Title"] = "جرد الاستخدام";
    var approvedRequests = ViewBag.ApprovedRequests as List<Yad_Aloun2.Models.AssistanceRequest>;
}

<style>
    @@media print {
        /* إخفاء الهيدر، الفوتر، القوائم الجانبية، الفورم، وأي أزرار عند الطباعة */
        .card-header, #usageForm, .btn, .alert, header, footer, .nav {
            display: none !important;
        }
        /* إلغاء الحواف والظلال لتوفير الحبر وضمان وضوح الجدول */
        .card {
            border: none !important;
            box-shadow: none !important;
        }

        body {
            background-color: #fff !important;
            direction: rtl;
        }
        /* إضافة عنوان مخصص يظهر فقط في الورقة المطبوعة */
        .print-header {
            display: block !important;
            text-align: center;
            margin-bottom: 30px;
        }
    }
    /* إخفاء عنوان الطباعة في الشاشة العادية */
    .print-header {
        display: none;
    }
</style>

<div class="container py-4">

    <div class="print-header">
        <h2 class="fw-bold" style="color:#064e3b;">تقرير جرد الاستخدام للطلبات المكتملة</h2>
        <p class="text-muted">تاريخ استخراج التقرير: @DateTime.Now.ToString("yyyy/MM/dd")</p>
        <hr />
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 shadow-sm mb-4">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 shadow-sm mb-4">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0 text-success">
                <i class="fas fa-plus-circle me-2"></i> تسجيل استخدام لطلب مساعدة مقبول
            </h5>
        </div>
        <div class="card-body bg-light rounded-bottom-4">
            <form asp-action="AddUsageInventory" method="post" id="usageForm">
                @Html.AntiForgeryToken()

                <input type="hidden" name="BeneficiaryName" id="hiddenBeneficiaryName" />
                <input type="hidden" name="ServiceName" id="hiddenServiceName" />
                <input type="hidden" name="Rating" value="0" />

                <div class="row g-3 align-items-end">

                    <div class="col-md-9">
                        <label class="form-label small fw-bold text-muted">اختر طلب المساعدة المقبول</label>
                        <select class="form-select form-control-lg border-0 shadow-sm rounded-3" id="requestSelector" required>
                            <option value="">-- اختر من الطلبات المقبولة المتاحة --</option>
                            @if (approvedRequests != null && approvedRequests.Any())
                            {
                                foreach (var req in approvedRequests)
                                {
                                    <option value="@req.Id" data-beneficiary="مستفيد رقم (@req.UserId)" data-service="@req.Title">
                                        الطلب: @req.Title (الرد: @req.AdminNotes)
                                    </option>
                                }
                            }
                            else
                            {
                                <option disabled>لا توجد طلبات مقبولة تحتوي على ردود حالياً</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success w-100 py-2.5 fw-bold rounded-3 shadow-sm" style="background:#064e3b; border:none;">
                            <i class="fas fa-save me-1"></i> ترحيل إلى الجرد
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>


    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0" style="color:#064e3b;">
                <i class="fas fa-list-alt me-2"></i> سجل جرد الاستخدام الحالي
            </h4>

            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm px-4 py-2 rounded-3 fw-bold">
                <i class="fas fa-print me-1"></i> طباعة التقرير
            </button>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-hover">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-4">المستفيد</th>
                            <th>الخدمة المقدمة</th>
                            <th class="pe-4">التاريخ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">@item.BeneficiaryName</td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 bg-light text-success fw-bold border">
                                            @item.ServiceName
                                        </span>
                                    </td>
                                    <td class="text-muted pe-4">
                                        <i class="far fa-calendar-alt me-1"></i> @item.UsageDate.ToString("yyyy/MM/dd")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <i class="fas fa-folder-open d-block mb-2" style="font-size: 30px;"></i>
                                    لا توجد أي سجلات جرد مسجلة حالياً.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.getElementById('requestSelector').addEventListener('change', function() {
            var selectedOption = this.options[this.selectedIndex];

            if (selectedOption.value !== "") {
                document.getElementById('hiddenBeneficiaryName').value = selectedOption.getAttribute('data-beneficiary');
                document.getElementById('hiddenServiceName').value = selectedOption.getAttribute('data-service');
            } else {
                document.getElementById('hiddenBeneficiaryName').value = "";
                document.getElementById('hiddenServiceName').value = "";
            }
        });
    </script>
}