@model IEnumerable< Yad_Aloun2.Models.Center>
@{
    ViewData["Title"] = "إدارة المراكز والخدمات";
}
@{
    Layout = "_Layout";
}


<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold">إدارة المراكز والخدمات</h4>

        <input type="text" class="form-control w-25" placeholder="بحث في البيانات...">
    </div>

    <!-- Card -->
    <div class="card shadow-sm rounded-4">

        <!-- Top Bar -->
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
            <a asp-action="Create"
               asp-controller="Admin"
               class="btn btn-success rounded-pill px-4">

                + إضافة جديد

            </a>
            <span class="text-muted">
                إجمالي المراكز: @Model.Count()
            </span>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table text-center align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>اسم المركز</th>
                        <th>التخصص</th>
                        <th>المنطقة</th>
                        <th>الحالة</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.CenterName</td>
                            <td>@item.Category</td>
                            <td>@item.Region</td>

                            <td>
                                <span class="badge rounded-pill px-3 py-2
                                        @(item.Status == "نشط" ? "bg-success-subtle text-success" : "bg-warning-subtle text-dark")">
                                    @item.Status
                                </span>
                            </td>

                            <td>
                                <a asp-controller="Admin" asp-action="Edit" asp-route-id="@item.Center_Id" class="text-secondary me-2">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Center_Id" class="text-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>
</div>