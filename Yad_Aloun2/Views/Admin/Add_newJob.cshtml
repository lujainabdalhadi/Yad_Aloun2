@model IEnumerable<Yad_Aloun2.Models.JobOpportunity>
@{
    ViewData["Title"] = "اضافه وظيفه";
}
@{
    Layout = "_Layout";
}

<h2 class="mb-4"> اضافه وظيفه</h2>

<a asp-action="AddJob" class="btn btn-success mb-3">
    + إضافة وظيفة جديدة
</a>

<table class="table table-hover">
    <thead>
        <tr>
            <th>عنوان الوظيفة</th>
         
            <th>الراتب</th>
            <th>نوع الدوام</th>
            <th>الإجراءات</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var job in Model)
        {
            <tr>
                <td>@job.JobTitle</td>
               
                <td>@job.Salary</td>
                <td>@job.JobType</td>

                <td>
                    <a asp-action="EditJob"
                       asp-route-id="@job.Id"
                       class="btn btn-warning btn-sm">
                        تعديل
                    </a>

                    <a asp-action="DeleteJob"
                       asp-route-id="@job.Id"
                       class="btn btn-danger btn-sm">
                        حذف
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>