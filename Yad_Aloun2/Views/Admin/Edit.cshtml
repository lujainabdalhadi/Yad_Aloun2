@model Yad_Aloun2.Models.Center
@{
    ViewData["Title"] = "  صفحه التعديل";
}
@{
    Layout = "_Layout";
}

<div class="container mt-5">

    <div class="card shadow-sm rounded-4 p-4">

        <!-- Title -->
        <h4 class="fw-bold mb-4 text-center">تعديل بيانات المركز</h4>

        <!-- Form -->
        <form asp-action="Edit" method="post" >
            @Html.AntiForgeryToken()
            
            <input type="hidden" asp-for="Center_Id" />

            <div class="row">

                <!-- اسم المركز -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">اسم المركز</label>
                    <input asp-for="CenterName" class="form-control rounded-pill" />
                    <span asp-validation-for="CenterName" class="text-danger"></span>
                </div>

                <!-- التخصص -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">التخصص</label>
                    <input asp-for="Category" class="form-control rounded-pill" />
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <!-- المنطقة -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">المنطقة</label>
                    <input asp-for="Region" class="form-control rounded-pill" />
                    <span asp-validation-for="Region" class="text-danger"></span>
                </div>

                <!-- الحالة -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">الحالة</label>
                    <select asp-for="Status" class="form-select rounded-pill">
                        <option value="">-- اختر الحالة --</option>
                        <option value="نشط">نشط</option>
                        <option value="قيد الانتظار">قيد الانتظار</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

            </div>

            <!-- Buttons -->
            <div class="text-center mt-4">

                <button type="submit" class="btn btn-success px-4 rounded-pill">
                    حفظ التعديلات
                </button>

                <a asp-action="CentersAndServicesManagement" asp-controller="Admin" class="btn btn-secondary px-4 rounded-pill ms-2">
                    رجوع
                </a>

            </div>

        </form>
    </div>

</div>