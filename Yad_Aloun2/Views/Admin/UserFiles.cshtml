@model IEnumerable<Yad_Aloun2.Models.UserFiles>

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <button class="btn btn-light rounded-pill px-3">
            تصدير CSV
        </button>

        <div class="text-end">
            <h5 class="fw-bold">ملفات المستخدمين</h5>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm rounded-4 p-3">

        <div class="table-responsive">
            <table class="table align-middle text-center">

                <thead class="table-light">
                    <tr>
                        <th>المستخدم</th>
                        <th>الفئة</th>
                        <th>نوع الإعاقة</th>
                        <th>آخر تواجد</th>
                        <th>الحالة</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- User -->
                            <td class="d-flex align-items-center justify-content-end gap-2">

                                <span class="avatar-circle">
                                    @item.Name.Substring(0, 1)
                                </span>

                                <span class="fw-semibold">@item.Name</span>
                            </td>

                            <!-- Category -->
                            <td>@item.Category</td>

                            <!-- Disability -->
                            <td>
                                <span class="badge bg-light text-dark px-3 py-2">
                                    @item.DisabilityType
                                </span>
                            </td>

                            <!-- Last Seen -->
                            <td class="text-muted">@item.LastSeen</td>

                            <!-- Status -->
                            <td>
                                <span class="text-danger fw-semibold">
                                    @item.Status
                                </span>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>
</div>