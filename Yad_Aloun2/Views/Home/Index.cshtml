            <h2 class="display-3 fw-bold mb-4">
                لأن الجميع يستحق الدعم.. <br>
                <span class="text-success">نحن بوابتكم نحو التمكين</span>
            </h2>
            <p class="lead mb-5" style="max-width: 600px;">
                منصة متخصصة لتسهيل حياة ذوي الإعاقة عبر ربطهم بأفضل المراكز والخدمات.
            </p>
            <div class="d-flex gap-3">
                <a href='@Url.Action("ReadMore", "services") ' class="btn btn-success btn-lg px-5 py-3 rounded-pill shadow">
                    اقرأ المزيد
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Hero End -->
<!-- Hero End -->
<!-- Hero End -->
<!-- About Start -->
<section class="help-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- النصوص -->
            <div class="feature-badge">
                <i class="fas fa-sparkles"></i>
                <div class="col-lg-6 order-2 order-lg-1">
                    <span class="section-tag">خطوات بسيطة.. دعم مستمر</span>
                    <h2 class="help-title">ابدأ بتقديم طلب المساعدة الآن</h2>

                    <div class="feature-item">
                        <div class="feature-icon"><i class="fas fa-user-check"></i></div>
                        <div>
                            <h5 class="fw-bold">سهولة الوصول</h5>
                            <p class="text-muted">نظام بسيط مصمم خصيصاً ليناسب احتياجاتكم مع واجهة سهلة الاستخدام.</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon"><i class="fas fa-shield-alt"></i></div>
                        <div>
                            <h5 class="fw-bold">خصوصية وأمان</h5>
                            <p class="text-muted">بياناتكم وطلباتكم تُعالج بمنتهى السرية والاحترافية من قبل مختصين.</p>
                        </div>
                    </div>

                    <p class="help-text mb-5 text-muted">
                        نحن نؤمن بأن لكل فرد الحق في الحصول على المساعدة بطريقة كريمة. يتيح لك نظامنا تقديم طلبك بخطوات منظمة، وإرفاق المستندات اللازمة، لنقوم بتوصيلك بالجهات الداعمة في أسرع وقت.
                    </p>

                    <button class="btn btn-primary-action btn-lg" onclick="location.href='@Url.Action("RequestAssistance", "services")'">
                        قدّم طلبك الآن
                        <i class="fas fa-arrow-left ms-3"></i>
                    </button>
                </div>

                <!-- الصورة -->
                <div class="col-lg-6 order-1 order-lg-2">
                    <div class="image-wrapper">
                        <img src="~/img/help.jpeg"
                             alt="صورة تعبيرية للمساعدة"
                             class="img-fluid w-100">
                    </div>
                </div>
            </div>
        </div>
</section>
<!-- Services Start -->
<section class="services-section">
    <div class="container">
        <div class="section-title-wrapper">
            <h2>الخدمات الأساسية</h2>
            <p class="text-muted fs-5">نقدم حلولاً متكاملة لدعمكم في كافة مجالات الحياة</p>
        </div>

        <div class="row g-4">
            <!-- الوظائف -->
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-icon-wrapper">
                        <i class="fas fa-user-md"></i>
                    </div>
                    <h4>الوظائف</h4>
                    <p>بوابة تمكين أصحاب الهمم، جسراً يصلك بأفضل الفرص الوظيفية وبيئات العمل الدامجة والمحفزة للنمو.</p>
                    <!-- الرابط الخاص بك مدمج هنا -->
                    <a href="@Url.Action("Jobs", "services")" class="service-btn">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                </div>
            </div>

            <!-- خريطة المراكز -->
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-icon-wrapper">
                        <!-- الأيقونة fa-map-marked-alt أكثر دقة للخريطة من fa-procedures -->
                        <i class="fas fa-map-marked-alt"></i>
                    </div>
                    <h4>خريطة المراكز والخدمات</h4>
                    <p>بوصلة الوصول الشامل ترشدك لأقرب مراكز الدعم والخدمات المخصصة لك بكل سهولة ويسر جغرافي.</p>
                    <!-- الرابط الخاص بك مدمج هنا -->
                    <a href="@Url.Action("ServerMap", "services")" class="service-btn">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                </div>
            </div>

            <!-- الدعم النفسي -->
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-icon-wrapper">
                        <i class="fas fa-stethoscope"></i>
                    </div>
                    <h4>الدعم النفسي</h4>
                    <p>جلسات توعوية وإرشادية متخصصة لتخفيف الضغط عن أنفسكم وتعزيز الصحة النفسية والصلابة الذاتية.</p>
                    <!-- الرابط الخاص بك مدمج هنا -->
                    <a href="@Url.Action("FamilySupport", "services")" class="service-btn">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Services End -->
<!-- Appointment Start -->
<!-- Appointment End -->
<div class="container1-fluid my-5 py-5" style="background-color:  #064e3b;">
    <div class="container py-5">
