<!-- منطقة الـ Hero -->
<!-- منطقة الـ Hero باستخدام Bootstrap فقط -->
<section class="position-relative overflow-hidden rounded-5 shadow-lg my-5" style="height: 550px; border-radius: 0 !important;">
    <!-- الصورة كخلفية كاملة -->
    <img src="~/img/heroo.jpg"
         alt="Background"
         class="position-absolute w-100 h-100"
         style="object-fit: cover; z-index: -1;">

    <!-- طبقة التراكب والنصوص -->
